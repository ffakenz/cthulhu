{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-level Claude Code settings, committed so every session starts with the same allowlist. Per-user overrides go in .claude/settings.local.json (gitignored). allow holds reads and local work, with cargo beyond fmt only in the exact forms the Makefile runs. ask holds what lands, rewrites or deletes work, changes a remote, or adds a crate or a tool: never the agent's decision, always available with a person's consent. deny holds only what no approval makes recoverable. attribution keeps every commit and PR free of trailer lines.",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git switch -c:*)",
      "Bash(git remote -v)",
      "Bash(git worktree list)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh auth status)",
      "Bash(make)",
      "Bash(make help)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make lint)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make deps)",
      "Bash(make ci)",
      "Bash(make run)",
      "Bash(make clean)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy --workspace --all-targets --all-features --locked -- -D warnings)",
      "Bash(cargo build --workspace --locked)",
      "Bash(cargo test --workspace --locked)",
      "Bash(cargo tree --workspace --locked --edges normal,build,dev --target all --all-features --prefix none --format '{p}')",
      "Bash(cargo tree --workspace --locked --edges no-dev --target all --all-features --prefix none --format '{p}')",
      "Bash(cargo tree --workspace --locked --depth 0 --prefix none --format '{p}')",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(which:*)",
      "Bash(wc:*)"
    ],
    "ask": [
      "Bash(git commit --amend:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rename:*)",
      "Bash(cargo add:*)",
      "Bash(cargo install:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
